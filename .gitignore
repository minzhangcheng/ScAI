*.log*
.*
log/
!.gitignore
!.dockerignore

# Dependencies
node_modules/
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
*.dist-info/

# Build output
dist/
build/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*~

# Marker database TSVs live under $SCAI_DATA_DIR/markers, outside the code tree
# entirely (see scripts/fetch_markers.py). This rule is a backstop against a
# stray copy being committed and then baked into a container image.
backend/data/markers/
states/
# Cached MSigDB GMTs live under $SCAI_DATA_DIR/gene_sets now; backstop only.
backend/data/gene_sets/
review.md

# Demonstration inputs are large raw data — loom files, pathology TIFs, h5
# matrices — distributed outside version control; two of them exceed GitHub's
# 100 MB per-file ceiling. A local copy lives at the path the demo pipelines
# expect without ever being staged.
demo/*/upload/
# Immutable test runner evidence and local-only identities
test-results/
.scai-test-deps-image.json
