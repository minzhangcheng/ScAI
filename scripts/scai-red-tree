#!/usr/bin/env bash
# Prove a regression test fails on the tree that does not yet contain its fix.
#
# An exported tarball of a commit cannot be used: scripts/scai-test resolves
# HEAD before it reaches pytest and dies without a repository, so the run
# produces no evidence at all while looking like a failure. A detached
# worktree has a .git file pointing at the main repository, so the runner
# works there.
#
# Note for test authors: a module that raises while being collected makes the
# runner report an incomplete collection and publish nothing. Read the artifact
# under test inside the test functions, not at import, or the red evidence is
# unreadable.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

die() { echo "error: $*" >&2; exit 2; }
[[ $# -ge 3 ]] || die "usage: scripts/scai-red-tree <base-ref> <test-file> <node> [<node> ...]"

BASE_REF="$1"; shift
TEST_FILE="$1"; shift
[[ -f "$TEST_FILE" ]] || die "no such test file: $TEST_FILE"

BASE_SHA="$(git rev-parse --verify "${BASE_REF}^{commit}")"
# Unique per invocation: a fixed per-SHA path meant two concurrent checks
# deleted each other's worktree mid-run.
WORKTREE="/home/minzhang/scai-red-tree/${BASE_SHA:0:12}.$$"

cleanup() {
    git worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true
    rm -rf "$WORKTREE"
    git worktree prune >/dev/null 2>&1 || true
}
trap cleanup EXIT

rm -rf "$WORKTREE"
git worktree prune >/dev/null 2>&1 || true
mkdir -p "$(dirname "$WORKTREE")"
git worktree add --detach "$WORKTREE" "$BASE_SHA" >/dev/null

mkdir -p "$WORKTREE/$(dirname "$TEST_FILE")"
cp "$TEST_FILE" "$WORKTREE/$TEST_FILE"

declare -a NODES=("$@")
declare -a EXPECTED=()
for node in "$@"; do
    if [[ "$node" == *"::"* ]]; then EXPECTED+=("${node##*::}"); fi
done
# Refused before anything is created or run. Checking a whole file accepts any
# pre-existing failure in it as proof that this regression test detects the
# defect it was written for, which is exactly the claim being made.
if [[ ${#EXPECTED[@]} -eq 0 ]]; then
    die "name the nodes to prove, as file::test_name (a whole-file or -k selection cannot be verified)"
fi

set +e
( cd "$WORKTREE" && scripts/scai-test fast "${NODES[@]}" )
STATUS=$?
set -e

if [[ "$STATUS" -eq 0 ]]; then
    echo "RED-TREE FAILED: the test passed at $BASE_SHA, so it proves nothing" >&2
    exit 1
fi

# A non-zero exit is not evidence on its own. The runner exits non-zero for
# usage and configuration errors too -- a parametrised node id containing
# brackets is read as a glob and rejected before pytest starts -- and that
# would report a red tree without a single test having run. Only published
# evidence with a non-zero failed+errors count proves the point.
EVIDENCE="$(ls -td "$WORKTREE"/test-results/*/ 2>/dev/null | head -1 || true)"
if [[ -z "$EVIDENCE" || ! -f "${EVIDENCE}evidence.json" ]]; then
    echo "RED-TREE INCONCLUSIVE: the run at $BASE_SHA published no evidence" >&2
    echo "  (exit $STATUS -- the runner refused to start rather than the test failing;" >&2
    echo "   bracketed parametrised node ids must be selected with -k instead)" >&2
    exit 2
fi

# A count is not a signature. A fixture blowing up on a missing dependency also
# raises the failed+errors total, and would then be reported as proof that this
# regression test detects the defect. Only two shapes count: a call-phase
# failure, or the guard this project's tests use to say the module under test
# does not exist yet.
OBSERVED="$(python3 - "${EVIDENCE}junit.xml" "${EXPECTED[@]}" <<'PY'
import sys
import xml.etree.ElementTree as ET

MISSING_SUBJECT = "module under test is missing"
expected = set(sys.argv[2:])
qualifying = set()
other_errors = []
for case in ET.parse(sys.argv[1]).iter("testcase"):
    name = case.get("name") or ""
    if case.find("failure") is not None:
        qualifying.add(name)
        continue
    error = case.find("error")
    if error is None:
        continue
    if MISSING_SUBJECT in (error.get("message") or "") or MISSING_SUBJECT in (error.text or ""):
        qualifying.add(name)
    else:
        other_errors.append(f"{name}: {(error.get('message') or '')[:120]}")

if expected:
    # Every named node has to be the one that failed. Counting any failure in
    # the file would accept an unrelated pre-existing failure as proof that this
    # regression test detects the defect it was written for.
    unproven = sorted(
        node for node in expected
        if not any(name == node or name.startswith(node + "[") for name in qualifying)
    )
    for node in unproven:
        print("UNPROVEN " + node, file=sys.stderr)
    print(0 if unproven else len(expected))
else:
    print(len(qualifying))

for line in other_errors[:5]:
    print("UNQUALIFIED " + line, file=sys.stderr)
PY
)"
if [[ "$OBSERVED" -le 0 ]]; then
    echo "RED-TREE INCONCLUSIVE: at $BASE_SHA, not every named node failed the way" >&2
    echo "  a detection would (see UNPROVEN/UNQUALIFIED above)" >&2
    echo "  (any errors above are setup or environment problems, not evidence" >&2
    echo "   that the test detects the defect it was written for)" >&2
    exit 2
fi
echo "RED-TREE OK: $OBSERVED test(s) failed at $BASE_SHA as required"
