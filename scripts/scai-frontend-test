#!/usr/bin/env bash
set -euo pipefail
export SCAI_FRONTEND_RUNNER_PATH="$0"
exec python3 - "$@" <<'PYTHON_EOF'
"""Run the locked frontend install and Vitest with isolated, auditable state."""

from __future__ import annotations

import fcntl
import hashlib
import importlib.util
import json
import os
import re
import signal
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import uuid
from dataclasses import dataclass
from pathlib import Path
from typing import Any


BASE_COMMIT = "0c1edf479f7360dc80afa89cf7fc9534c1effce6"
REGISTRY = "https://registry.npmjs.org/"
CONFIG_KEYS = ("cache", "userconfig", "globalconfig", "registry", "audit", "fund", "update-notifier")
SECRET_KEYS = {"_auth", "_authtoken", "_password", "password", "token", "cert", "key"}
REGISTRY_SECRET = re.compile(
    r"^//[^/]+(?:/[^:]*)?/:(_auth|_authtoken|_password|password|token|cert|key)$",
    re.IGNORECASE,
)
VITEST_FIELDS = (
    "numTotalTestSuites", "numPassedTestSuites", "numFailedTestSuites", "numPendingTestSuites",
    "numTotalTests", "numPassedTests", "numFailedTests", "numPendingTests", "numTodoTests",
)
NODE_PLATFORM_QUERY = "JSON.stringify({platform:process.platform,arch:process.arch})"


@dataclass(frozen=True)
class ArtifactBytes:
    name: str
    payload: bytes
    size: int
    sha256: str


class FrontendError(RuntimeError):
    def __init__(self, label: str, message: str):
        super().__init__(message)
        self.label = label


def fail(label: str, message: str) -> None:
    raise FrontendError(label, message)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def json_hash(value: Any) -> str:
    return sha256_bytes(canonical_json(value))


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    data = json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8") + b"\n"
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def fsync_directory(path: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def read_fd_bytes(fd: int) -> bytes:
    chunks: list[bytes] = []
    while True:
        block = os.read(fd, 1024 * 1024)
        if not block:
            break
        chunks.append(block)
    return b"".join(chunks)


def read_one_nofollow(path: Path) -> ArtifactBytes:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        fail("frontend evidence", f"cannot open artifact {path}: {exc}")
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            fail("frontend evidence", f"unsafe artifact: {path}")
        payload = read_fd_bytes(fd)
        return ArtifactBytes(path.name, payload, len(payload), sha256_bytes(payload))
    finally:
        os.close(fd)


def read_direct_children_nofollow(root: Path, expected_names: set[str]) -> dict[str, ArtifactBytes]:
    if any(not name or "/" in name or name in {".", ".."} for name in expected_names):
        fail("frontend evidence", "artifact registration contains a non-direct name")
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        root_fd = os.open(root, flags)
    except OSError as exc:
        fail("frontend evidence", f"result directory is not a safe directory: {exc}")
    try:
        actual_names = set(os.listdir(root_fd))
        if actual_names != expected_names:
            fail("frontend evidence", f"result artifact allowlist mismatch: {sorted(actual_names)}")
        result: dict[str, ArtifactBytes] = {}
        for name in sorted(expected_names):
            try:
                fd = os.open(
                    name,
                    os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0),
                    dir_fd=root_fd,
                )
            except OSError as exc:
                fail("frontend evidence", f"cannot open result artifact {name}: {exc}")
            try:
                info = os.fstat(fd)
                if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                    fail("frontend evidence", f"unsafe result artifact: {name}")
                payload = read_fd_bytes(fd)
                result[name] = ArtifactBytes(name, payload, len(payload), sha256_bytes(payload))
            finally:
                os.close(fd)
        return result
    finally:
        os.close(root_fd)


def write_sealed_file(result_dir: Path, name: str, payload: bytes) -> ArtifactBytes:
    if not name or "/" in name or name in {".", ".."}:
        fail("frontend evidence", f"invalid sealed artifact name: {name!r}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(result_dir / name, flags, 0o644)
    except OSError as exc:
        fail("frontend evidence", f"cannot create sealed artifact {name}: {exc}")
    try:
        offset = 0
        while offset < len(payload):
            offset += os.write(fd, payload[offset:])
        os.fchmod(fd, 0o644)
        os.fsync(fd)
    finally:
        os.close(fd)
    fsync_directory(result_dir)
    loaded = read_one_nofollow(result_dir / name)
    if loaded.payload != payload or loaded.sha256 != sha256_bytes(payload):
        fail("frontend evidence", f"sealed artifact changed after write: {name}")
    return loaded


def lstat_or_none(path: Path) -> os.stat_result | None:
    try:
        return path.lstat()
    except FileNotFoundError:
        return None


def require_regular(path: Path, label: str, *, allow_symlink: bool = False) -> None:
    info = lstat_or_none(path)
    if info is None:
        fail(label, f"missing file: {path}")
    if stat.S_ISLNK(info.st_mode) and not allow_symlink:
        fail(label, f"symlink is not allowed: {path}")
    if not stat.S_ISREG(info.st_mode):
        fail(label, f"not a regular file: {path}")
    if info.st_nlink != 1:
        fail(label, f"hardlink is not allowed: {path}")


def require_directory(path: Path, label: str) -> None:
    info = lstat_or_none(path)
    if info is None or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(label, f"directory is missing or unsafe: {path}")


def ensure_directory(path: Path, label: str, mode: int = 0o700) -> None:
    info = lstat_or_none(path)
    if info is None:
        try:
            path.mkdir(mode=mode)
        except FileExistsError:
            info = lstat_or_none(path)
        else:
            return
    if info is None or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(label, f"unsafe directory: {path}")
    os.chmod(path, mode)


def path_inside(path: Path, root: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(root.resolve(strict=False))
        return True
    except ValueError:
        return False


def safe_lock(path: Path, label: str) -> int:
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o600)
    except OSError as exc:
        fail(label, f"cannot open lock {path}: {exc}")
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        os.close(fd)
        fail(label, f"unsafe lock file: {path}")
    os.fchmod(fd, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError as exc:
        os.close(fd)
        fail(label, f"cannot acquire lock {path}: {exc}")
    return fd


def unlock(fd: int | None) -> None:
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def load_tree_helper(repo: Path):
    path = repo / "scripts" / "scai_test_tree.py"
    spec = importlib.util.spec_from_file_location("scai_frontend_tree", path)
    if spec is None or spec.loader is None:
        fail("source manifest", "cannot load scripts/scai_test_tree.py")
    module = importlib.util.module_from_spec(spec)
    previous = sys.modules.get(spec.name)
    sys.modules[spec.name] = module
    try:
        spec.loader.exec_module(module)
    finally:
        if previous is None:
            sys.modules.pop(spec.name, None)
        else:
            sys.modules[spec.name] = previous
    return module


def source_snapshot(repo: Path, tree: Any) -> dict[str, Any]:
    try:
        return tree.build_worktree_manifest(repo, BASE_COMMIT)
    except Exception as exc:
        fail("source manifest", str(exc))


def source_node_modules_state(frontend: Path) -> tuple[str, str | None]:
    path = frontend / "node_modules"
    info = lstat_or_none(path)
    if info is None:
        return "absent", None
    if stat.S_ISLNK(info.st_mode):
        return "symlink", os.readlink(path)
    if stat.S_ISDIR(info.st_mode):
        fail("source node_modules", "real frontend/node_modules directory is forbidden")
    fail("source node_modules", "frontend/node_modules is a special file")


def input_hashes(frontend: Path) -> tuple[str, str, str]:
    package = frontend / "package.json"
    lock = frontend / "package-lock.json"
    require_regular(package, "frontend inputs")
    require_regular(lock, "frontend inputs")
    package_hash = sha256_file(package)
    lock_hash = sha256_file(lock)
    input_key = sha256_bytes(f"package.json {package_hash}\npackage-lock.json {lock_hash}\n".encode())
    return package_hash, lock_hash, input_key


def normalize_path_value(value: Any, expected: str) -> Any:
    if isinstance(expected, str) and (expected.startswith("/") or "/" in expected):
        return str(Path(str(value)).resolve(strict=False))
    return value


def check_secret_key(key: str, value: Any) -> None:
    normalized = key.lower()
    if REGISTRY_SECRET.fullmatch(normalized):
        fail("npm config secret", f"registry-scoped credential key is forbidden: {key}")
    if normalized in SECRET_KEYS and value not in (None, "", False):
        fail("npm config secret", f"credential key is forbidden: {key}")


def expected_config(install_dir: Path, cache_dir: Path, userconfig: Path, globalconfig: Path) -> dict[str, Any]:
    return {
        "cache": str(cache_dir.resolve()),
        "userconfig": str(userconfig.resolve()),
        "globalconfig": str(globalconfig.resolve()),
        "registry": REGISTRY,
        "audit": False,
        "fund": False,
        "update-notifier": False,
    }


def normalize_config(value: Any, expected: Any) -> Any:
    if isinstance(expected, bool):
        if not isinstance(value, bool):
            fail("npm config values", f"boolean config value is malformed: {value!r}")
        return value
    if isinstance(expected, str) and expected.startswith("/"):
        return str(Path(str(value)).resolve(strict=False))
    return value


def parse_npm_config_values(raw: bytes, expected: dict[str, Any], empty_hashes: dict[str, str]) -> dict[str, Any]:
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as exc:
        fail("npm config values", f"JSON output is malformed: {exc}")
    if not isinstance(value, dict):
        fail("npm config values", "JSON output is not an object")
    for key, item in value.items():
        if isinstance(key, str):
            check_secret_key(key, item)
    if value.get("json") is not True:
        fail("npm config values", "command-owned json=true is missing")
    if value.get("location") != "project" or not isinstance(value.get("location"), str):
        fail("npm config values", "command-owned location=project is missing or malformed")
    effective: dict[str, Any] = {}
    for key, expected_value in expected.items():
        if key not in value:
            fail("npm config values", f"planned override is missing: {key}")
        actual = normalize_config(value[key], expected_value)
        if actual != expected_value:
            fail("npm config values", f"planned override drift: {key}={actual!r}")
        effective[key] = actual
    builtin = {key: item for key, item in value.items() if key not in set(expected) | {"json", "location"}}
    return {
        "schema": 1,
        "command_key": "npm_config_values",
        "command_owned": {"json": True, "location": "project"},
        "effective_overrides": effective,
        "builtin_values_sha256": json_hash(builtin),
        "empty_config_hashes": empty_hashes,
        "raw_stdout_sha256": sha256_bytes(raw),
    }


def parse_config_value(text: str) -> Any:
    value = text.strip()
    if value.startswith('"') and value.endswith('"'):
        try:
            return json.loads(value)
        except ValueError:
            return value[1:-1]
    if value.lower() == "true":
        return True
    if value.lower() == "false":
        return False
    return value


def validate_npm_config_agreement(values: dict[str, Any], sources: dict[str, Any]) -> None:
    value_overrides = values.get("effective_overrides")
    source_overrides = sources.get("final_effective_overrides")
    if (
        not isinstance(value_overrides, dict)
        or not isinstance(source_overrides, dict)
        or set(value_overrides) != set(CONFIG_KEYS)
        or set(source_overrides) != set(CONFIG_KEYS)
        or value_overrides != source_overrides
    ):
        fail("npm config agreement", "JSON and plain npm config overrides disagree")
    if values.get("command_owned") != {"json": True, "location": "project"}:
        fail("npm config agreement", "JSON command-owned config is not exact")
    if sources.get("command_owned") != {"location": "project"}:
        fail("npm config agreement", "plain command-owned config is not exact")


def parse_npm_config_sources(raw: bytes, expected: dict[str, Any], empty_hashes: dict[str, str], install_dir: Path) -> dict[str, Any]:
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        fail("npm config sources", f"plain output is not UTF-8: {exc}")
    section_class = "npm builtin/default"
    section_path: str | None = None
    observed: list[dict[str, Any]] = []
    final: dict[str, Any] = {}
    environment_values: dict[str, Any] = {}
    command_owned: dict[str, Any] = {}
    file_keys: set[str] = set()
    environment_sections = 0
    cli_sections = 0
    header = re.compile(r'^\s*;\s*"([^"]+)" config from\s*(.*?)\s*$')
    assignment = re.compile(r"^\s*([A-Za-z0-9_./:@-]+)\s*=\s*(.*?)\s*$")
    for line in text.splitlines():
        match = header.match(line)
        if match:
            name, source = match.groups()
            lowered = name.lower()
            source_path = source.strip() or None
            if name == "env":
                if source_path != "environment":
                    fail("npm config sources", f"unexpected reserved env config source: {source_path}")
                environment_sections += 1
                if environment_sections != 1:
                    fail("npm config sources", "duplicate environment config section")
                section_class = "environment"
                section_path = source_path
            elif name == "cli":
                if source_path != "command line options":
                    fail("npm config sources", f"unexpected reserved cli config source: {source_path}")
                cli_sections += 1
                if cli_sections != 1:
                    fail("npm config sources", "duplicate command-owned CLI config section")
                section_class = "command-owned CLI"
                section_path = source_path
            elif "builtin" in lowered or "default" in lowered:
                section_class = "npm builtin/default"
                section_path = source_path
            elif source_path in {str((install_dir / ".npmrc").resolve()), str((install_dir / "global.npmrc").resolve())}:
                section_class = "empty config file"
                section_path = source_path
            else:
                fail("npm config sources", f"unexpected npm config source: {name} {source_path}")
            observed.append({"class": section_class, "path": section_path})
            continue
        if not line.strip() or line.lstrip().startswith(";"):
            continue
        match = assignment.match(line)
        if not match:
            fail("npm config sources", f"unrecognized config output line: {line!r}")
        key, raw_value = match.groups()
        if key == "location" and section_class != "command-owned CLI":
            fail("npm config sources", f"location assignment is forbidden in {section_class}")
        value = parse_config_value(raw_value)
        check_secret_key(key, value)
        if section_class == "environment":
            if key not in expected:
                fail("npm config sources", f"unexpected environment config key: {key}")
            if key in environment_values:
                fail("npm config sources", f"duplicate environment config key: {key}")
            environment_values[key] = value
            final[key] = value
        elif section_class == "command-owned CLI":
            if key != "location":
                fail("npm config sources", f"unexpected command-owned CLI config key: {key}")
            if key in command_owned:
                fail("npm config sources", "duplicate command-owned CLI location")
            if not isinstance(value, str) or value != "project":
                fail("npm config sources", "command-owned CLI location must be exact string project")
            command_owned[key] = value
        elif section_class == "empty config file":
            file_keys.add(key)
        else:
            final[key] = value
    if environment_sections and set(environment_values) != set(expected):
        fail("npm config sources", f"environment source key set drift: {sorted(environment_values)}")
    if cli_sections != 1 or command_owned != {"location": "project"}:
        fail("npm config sources", "exact command-owned CLI location=project section is required")
    if file_keys:
        fail("npm config sources", "an allowed npm config file was not empty")
    for name, relative in (("userconfig", ".npmrc"), ("globalconfig", "global.npmrc")):
        path = install_dir / relative
        require_regular(path, "npm config file")
        if path.stat().st_size != 0 or sha256_file(path) != empty_hashes[name]:
            fail("npm config file", f"allowed npm config file changed: {name}")
    for key, expected_value in expected.items():
        if key not in final:
            fail("npm config sources", f"final source value is missing: {key}")
        actual = normalize_config(final[key], expected_value)
        if actual != expected_value:
            fail("npm config sources", f"plain/JSON config drift: {key}={actual!r}")
    return {
        "schema": 1,
        "command_key": "npm_config_sources",
        "allowed_sources": ["npm builtin/default", "environment", "empty config file", "command-owned CLI"],
        "command_owned": {"location": "project"},
        "observed_sources": observed,
        "final_effective_overrides": {key: normalize_config(final[key], expected[key]) for key in expected},
        "empty_config_hashes": empty_hashes,
        "raw_stdout_sha256": sha256_bytes(raw),
    }


def tokenized(value: Any, repo: Path, result_dir: Path | None = None, install_dir: Path | None = None) -> Any:
    if isinstance(value, str):
        result = value
        replacements: list[tuple[str, str]] = []
        if install_dir is not None:
            replacements.append((str(install_dir.resolve()), "<install-dir>"))
        if result_dir is not None:
            replacements.append((str(result_dir.resolve()), "<result-dir>"))
        replacements.append((str(repo.resolve()), "<repo-root>"))
        for source, target in sorted(replacements, key=lambda pair: len(pair[0]), reverse=True):
            result = result.replace(source, target)
        return result
    if isinstance(value, list):
        return [tokenized(item, repo, result_dir, install_dir) for item in value]
    if isinstance(value, dict):
        return {key: tokenized(item, repo, result_dir, install_dir) for key, item in value.items()}
    return value


def command_env(node: Path, npm: Path, install_dir: Path, runtime_dir: Path) -> dict[str, str]:
    # Resolve node/npm before entering this environment.  Do not copy the
    # caller's PATH, node option variables, npmrc, or upper-case npm configuration.
    path_parts = list(dict.fromkeys([str(node.parent), str(npm.parent), *os.defpath.split(os.pathsep)]))
    home = runtime_dir / "home"
    cache = runtime_dir / "cache"
    xdg = runtime_dir / "xdg"
    for directory in (home, cache, xdg):
        ensure_directory(directory, "frontend isolated directories")
    userconfig = install_dir / ".npmrc"
    globalconfig = install_dir / "global.npmrc"
    return {
        "PATH": os.pathsep.join(path_parts),
        "HOME": str(home),
        "XDG_CONFIG_HOME": str(xdg),
        "XDG_CACHE_HOME": str(cache),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "npm_config_cache": str(cache),
        "npm_config_userconfig": str(userconfig),
        "npm_config_globalconfig": str(globalconfig),
        "npm_config_registry": REGISTRY,
        "npm_config_audit": "false",
        "npm_config_fund": "false",
        "npm_config_update_notifier": "false",
    }


def empty_config_file(path: Path) -> str:
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)
    require_regular(path, "npm config file")
    if path.stat().st_size != 0:
        fail("npm config file", f"config file is not empty: {path}")
    return sha256_file(path)


def verify_config_files(paths: dict[str, Path], expected_hashes: dict[str, str]) -> None:
    """Reopen the two command-owned files before each npm invocation."""
    for name, path in paths.items():
        require_regular(path, "npm config file")
        if path.stat().st_size != 0 or sha256_file(path) != expected_hashes[name]:
            fail("npm config file", f"command-owned config changed: {name}")


def command_record(
    name: str,
    argv: list[str],
    cwd: Path,
    env: dict[str, str],
    result_dir: Path,
    repo: Path,
    install_dir: Path,
    stdout_name: str,
    stderr_name: str,
) -> tuple[dict[str, Any], bytes, bytes]:
    stdout_path = result_dir / stdout_name
    stderr_path = result_dir / stderr_name
    start = time.time()
    with stdout_path.open("wb") as stdout, stderr_path.open("wb") as stderr:
        process = subprocess.run(argv, cwd=cwd, env=env, stdout=stdout, stderr=stderr, check=False)
    end = time.time()
    raw_stdout = stdout_path.read_bytes()
    raw_stderr = stderr_path.read_bytes()
    stdout_data = sanitize_output(raw_stdout, repo, result_dir, install_dir)
    stderr_data = sanitize_output(raw_stderr, repo, result_dir, install_dir)
    stdout_path.write_bytes(stdout_data)
    stderr_path.write_bytes(stderr_data)
    record = {
        "argv": tokenized(argv, repo, result_dir, install_dir),
        "cwd": tokenized(str(cwd), repo, result_dir, install_dir),
        "environment": tokenized(sorted(env.items()), repo, result_dir, install_dir),
        "utc_start_epoch": start,
        "utc_end_epoch": end,
        "duration_seconds": round(max(0.0, end - start), 6),
        "exit_code": process.returncode,
        "stdout": stdout_name,
        "stderr": stderr_name,
        "stdout_sha256": sha256_bytes(stdout_data),
        "stderr_sha256": sha256_bytes(stderr_data),
    }
    return record, raw_stdout, raw_stderr


def sanitize_output(raw: bytes, repo: Path, result_dir: Path, install_dir: Path) -> bytes:
    """Keep command artifacts useful without publishing checkout-local paths."""
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        fail("frontend output", "command output is not UTF-8")
    for source, target in sorted(
        (
            (str(install_dir.resolve()), "<install-dir>"),
            (str(result_dir.resolve()), "<result-dir>"),
            (str(repo.resolve()), "<repo-root>"),
        ),
        key=lambda pair: len(pair[0]),
        reverse=True,
    ):
        text = text.replace(source, target)
    return text.encode("utf-8")


def expected_name_from_key(key: str) -> str:
    suffix = key.rsplit("node_modules/", 1)[-1]
    parts = suffix.split("/")
    if parts[0].startswith("@"):
        if len(parts) < 2:
            fail("npm tree", f"scoped package path is malformed: {key}")
        return "/".join(parts[:2])
    return parts[0]


def canonicalize_bin_target(value: Any) -> str:
    """Canonicalize the one npm 9 bin-target lexical equivalence."""
    if not isinstance(value, str) or not value or "\0" in value or "\\" in value:
        fail("npm tree", "package bin target is malformed")
    canonical = value[2:] if value.startswith("./") else value
    if not canonical or canonical.startswith("/"):
        fail("npm tree", "package bin target is malformed")
    if any(not part or part in {".", ".."} for part in canonical.split("/")):
        fail("npm tree", "package bin target is malformed")
    if value not in {canonical, f"./{canonical}"}:
        fail("npm tree", "package bin target is malformed")
    return canonical


def normalize_bin(name: str, value: Any) -> dict[str, str]:
    if isinstance(value, str):
        entries = ((name.rsplit("/", 1)[-1], value),)
    elif isinstance(value, dict):
        entries = value.items()
    else:
        fail("npm tree", f"package bin declaration is malformed: {name}")
    normalized: dict[str, str] = {}
    for command, target in entries:
        if not isinstance(command, str) or not command:
            fail("npm tree", f"package bin declaration is malformed: {name}")
        normalized[command] = canonicalize_bin_target(target)
    return normalized


def npm_selector_applies(selector: object, actual: str, label: str) -> bool:
    """Apply npm positive/negative os or cpu selector semantics."""
    if selector is None:
        return True
    if not isinstance(selector, list) or not selector or any(not isinstance(item, str) or not item for item in selector):
        fail("npm tree", f"lock {label} selector is malformed")
    negatives = {item[1:] for item in selector if item.startswith("!")}
    if actual in negatives:
        return False
    positives = {item for item in selector if not item.startswith("!")}
    return not positives or actual in positives


def optional_omission_reason(
    locked: dict[str, object],
    node_platform: str,
    node_arch: str,
    npm_reported_optional_paths: frozenset[str],
    lock_path: str,
) -> str | None:
    """Return the exact host-owned reason for an omitted optional package."""
    if locked.get("optional") is not True:
        return None
    if "os" in locked and not npm_selector_applies(locked["os"], node_platform, "os"):
        return f"lock os selector excludes {node_platform}"
    if "cpu" in locked and not npm_selector_applies(locked["cpu"], node_arch, "cpu"):
        return f"lock cpu selector excludes {node_arch}"
    if lock_path in npm_reported_optional_paths:
        return "npm ls reported an optional omission"
    return None


def npm_ls_inventory(
    value: dict[str, object],
) -> tuple[
    frozenset[tuple[str, str]],
    tuple[tuple[str, str, str, str], ...],
    tuple[tuple[str, str, str], ...],
]:
    """Retain npm 9 identities and its logical parent graph without treating it as a disk tree."""
    identities: set[tuple[str, str]] = set()
    logical_nodes: list[tuple[str, str, str, str]] = []
    empty_edges: list[tuple[str, str, str]] = []
    seen_paths: set[str] = set()

    def visit(dependencies: Any, parent: str) -> None:
        if dependencies is None:
            return
        if not isinstance(dependencies, dict):
            fail("npm ls", "dependencies is not an object")
        for name, detail in sorted(dependencies.items()):
            if not isinstance(name, str) or not name or not isinstance(detail, dict):
                fail("npm ls", "dependency entry is malformed")
            parts = name.split("/")
            if (
                "\0" in name
                or "\\" in name
                or (name.startswith("@") and (len(parts) != 2 or any(not part for part in parts)))
                or (not name.startswith("@") and len(parts) != 1)
                or any(part in {".", ".."} for part in parts)
            ):
                fail("npm ls", f"dependency name is malformed: {name}")
            path = f"{parent}/node_modules/{name}" if parent else f"node_modules/{name}"
            if path in seen_paths:
                fail("npm ls", f"duplicate logical dependency path: {path}")
            seen_paths.add(path)
            if detail == {}:
                empty_edges.append((path, parent, name))
                continue
            version = detail.get("version")
            if not isinstance(version, str) or not version:
                fail("npm ls", f"dependency version is missing: {name}")
            identities.add((name, version))
            logical_nodes.append((path, parent, name, version))
            visit(detail.get("dependencies"), path)

    visit(value.get("dependencies"), "")
    return frozenset(identities), tuple(logical_nodes), tuple(empty_edges)


def require_contained_directory(path: Path, root_real: Path) -> Path:
    info = lstat_or_none(path)
    if info is None or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail("npm tree", f"invalid directory: {path}")
    real = path.resolve(strict=True)
    if not path_inside(real, root_real):
        fail("npm tree", f"directory escapes installation: {path}")
    return real


def require_target_file(path: Path, package_dir: Path, root_real: Path) -> None:
    info = lstat_or_none(path)
    if info is None or not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_nlink != 1:
        fail("npm tree", f"bin target is not a regular file: {path}")
    real = path.resolve(strict=True)
    if not path_inside(real, package_dir) or not path_inside(real, root_real):
        fail("npm tree", f"bin target escapes package/install: {path}")


def walk_npm_tree(
    install_dir: Path,
    npm_ls: dict[str, Any],
    node_platform: str,
    node_arch: str,
    npm_inventory: tuple[
        frozenset[tuple[str, str]],
        tuple[tuple[str, str, str, str], ...],
        tuple[tuple[str, str, str], ...],
    ] | None = None,
) -> dict[str, Any]:
    node_modules = install_dir / "node_modules"
    root_real = require_contained_directory(node_modules, install_dir.resolve())
    lock_path = install_dir / "package-lock.json"
    try:
        lock = json.loads(lock_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail("npm tree", f"package lock is malformed: {exc}")
    if lock.get("lockfileVersion") != 3 or not isinstance(lock.get("packages"), dict):
        fail("npm tree", "package-lock.json is not npm lockfile version 3")
    lock_packages = {key: value for key, value in lock["packages"].items() if key}
    npm_identities, npm_logical_nodes, npm_empty_edges = npm_inventory or npm_ls_inventory(npm_ls)
    for locked in lock_packages.values():
        if isinstance(locked, dict):
            for label in ("os", "cpu"):
                if label in locked:
                    npm_selector_applies(locked[label], node_platform if label == "os" else node_arch, label)
    records: list[dict[str, Any]] = []
    installed_metadata: dict[str, dict[str, Any]] = {}
    declarations: dict[str, dict[str, dict[str, Any]]] = {}
    bin_dirs: set[str] = set()
    hidden_paths: list[str] = []

    def register_package(package_dir: Path) -> None:
        require_contained_directory(package_dir, root_real)
        key = package_dir.relative_to(install_dir).as_posix()
        metadata = package_dir / "package.json"
        require_regular(metadata, "invalid package metadata")
        if not path_inside(metadata.resolve(), root_real):
            fail("npm tree", f"package metadata escapes installation: {key}")
        try:
            actual = json.loads(metadata.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            fail("npm tree", f"package metadata is malformed at {key}: {exc}")
        locked = lock_packages.get(key)
        if not isinstance(locked, dict) or actual.get("name") != expected_name_from_key(key) or actual.get("version") != locked.get("version"):
            fail("npm tree", f"installed/lock drift at {key}")
        if not isinstance(locked.get("resolved"), str) or not isinstance(locked.get("integrity"), str):
            fail("npm tree", f"lock identity is incomplete at {key}")
        installed_metadata[key] = actual
        actual_bin = normalize_bin(actual.get("name", ""), actual["bin"]) if "bin" in actual else {}
        locked_bin = normalize_bin(actual.get("name", ""), locked["bin"]) if "bin" in locked else {}
        if actual_bin != locked_bin:
            fail("npm tree", f"package bin drift at {key}")
        records.append({"path": key, "name": actual["name"], "version": actual["version"], "resolved": locked["resolved"], "integrity": locked["integrity"]})
        if actual_bin:
            # The final node_modules ancestor is the .bin directory level.
            marker = key.rfind("/node_modules/")
            level = key[: marker + len("/node_modules")] if marker >= 0 else "node_modules"
            expected = declarations.setdefault(level, {})
            for command, target in actual_bin.items():
                if not target or Path(target).is_absolute() or any(part == ".." for part in Path(target).parts):
                    fail("npm tree", f"bin target is unsafe at {key}: {command}")
                target_path = package_dir / target
                require_target_file(target_path, package_dir, root_real)
                if command in expected:
                    fail("npm tree", f"duplicate bin declaration at {level}/{command}")
                expected[command] = {
                    "target": target_path,
                    "target_rel": target_path.relative_to(install_dir).as_posix(),
                    "package": key,
                }
        nested = package_dir / "node_modules"
        if lstat_or_none(nested) is not None:
            visit_node_modules(nested)

    def visit_node_modules(directory: Path) -> None:
        level = directory.relative_to(install_dir).as_posix()
        require_contained_directory(directory, root_real)
        for entry in sorted(directory.iterdir(), key=lambda item: item.name):
            if entry.name == ".package-lock.json":
                require_regular(entry, "npm hidden lock")
                if not path_inside(entry.resolve(), root_real):
                    fail("npm tree", "hidden npm lock escapes installation")
                hidden_paths.append(entry.relative_to(install_dir).as_posix())
            elif entry.name == ".bin":
                require_contained_directory(entry, root_real)
                bin_dirs.add(level)
            elif entry.name.startswith("@"):
                require_contained_directory(entry, root_real)
                for child in sorted(entry.iterdir(), key=lambda item: item.name):
                    register_package(child)
            else:
                register_package(entry)

    visit_node_modules(node_modules)
    installed = {record["path"] for record in records}

    def resolve_node_module(parent: str, name: str, available: set[str]) -> str | None:
        """Resolve one dependency using Node's nearest ancestor node_modules order."""
        current = parent
        while current:
            candidate = f"{current}/node_modules/{name}"
            if candidate in available:
                return candidate
            marker = current.rfind("/node_modules/")
            current = current[:marker] if marker >= 0 else ""
        candidate = f"node_modules/{name}"
        return candidate if candidate in available else None

    logical_physical = {"": ""}
    for logical_path, logical_parent, name, version in npm_logical_nodes:
        parent = logical_physical.get(logical_parent)
        if parent is None:
            fail("npm ls", f"logical dependency parent is unknown: {logical_path}")
        physical = resolve_node_module(parent, name, installed)
        if physical is None:
            fail("npm ls", f"logical dependency is absent from the installed tree: {logical_path}")
        locked = lock_packages.get(physical)
        if not isinstance(locked, dict) or locked.get("version") != version:
            fail("npm ls", f"logical dependency identity differs from the lock: {logical_path}")
        logical_physical[logical_path] = physical

    all_lock_paths = set(lock_packages)
    npm_reported_optional_paths: set[str] = set()
    root_locked = lock["packages"].get("")
    for logical_path, logical_parent, name in npm_empty_edges:
        parent = logical_physical.get(logical_parent)
        if parent is None:
            fail("npm tree", f"npm ls empty dependency parent is unknown: {logical_path}")
        parent_locked = root_locked if not parent else lock_packages.get(parent)
        if not isinstance(parent_locked, dict):
            fail("npm tree", f"npm ls empty dependency parent is not locked: {logical_path}")
        parent_actual = None if not parent else installed_metadata.get(parent)
        if parent and not isinstance(parent_actual, dict):
            fail("npm tree", f"npm ls empty dependency parent is not installed: {logical_path}")

        optional_dependencies = parent_locked.get("optionalDependencies", {})
        if not isinstance(optional_dependencies, dict):
            fail("npm tree", f"parent optionalDependencies is malformed: {logical_path}")
        if name in optional_dependencies:
            optional_spec = optional_dependencies[name]
            if not isinstance(optional_spec, str) or not optional_spec:
                fail("npm tree", f"parent optional dependency is malformed: {logical_path}")
            if parent_actual is not None and parent_actual.get("optionalDependencies") != optional_dependencies:
                fail("npm tree", f"installed/lock optional dependency declaration drift: {logical_path}")
            target = resolve_node_module(parent, name, all_lock_paths)
            target_locked = lock_packages.get(target) if target is not None else None
            if (
                target is None
                or not isinstance(target_locked, dict)
                or not isinstance(target_locked.get("version"), str)
                or not target_locked["version"]
                or target_locked.get("optional") is not True
                or target in installed
            ):
                fail("npm tree", f"npm ls optional dependency target is invalid: {logical_path}")
            has_selector = "os" in target_locked or "cpu" in target_locked
            selector_reason = optional_omission_reason(
                target_locked, node_platform, node_arch, frozenset(), target
            )
            if has_selector and selector_reason is None:
                fail("npm tree", f"npm ls optional dependency selector still applies: {logical_path}")
            npm_reported_optional_paths.add(target)
            continue

        peer_dependencies = parent_locked.get("peerDependencies", {})
        peer_meta = parent_locked.get("peerDependenciesMeta", {})
        if not isinstance(peer_dependencies, dict) or not isinstance(peer_meta, dict):
            fail("npm tree", f"parent peer dependency metadata is malformed: {logical_path}")
        peer_spec = peer_dependencies.get(name)
        meta = peer_meta.get(name)
        if (
            not isinstance(peer_spec, str)
            or not peer_spec
            or not isinstance(meta, dict)
            or meta.get("optional") is not True
        ):
            fail("npm tree", f"npm ls reported an unknown or required empty dependency: {logical_path}")
        if parent_actual is not None and (
            parent_actual.get("peerDependencies") != peer_dependencies
            or parent_actual.get("peerDependenciesMeta") != peer_meta
        ):
            fail("npm tree", f"installed/lock optional peer declaration drift: {logical_path}")
        if resolve_node_module(parent, name, all_lock_paths) is not None:
            fail("npm tree", f"npm ls optional peer unexpectedly has a lock target: {logical_path}")

    optional_omissions: list[dict[str, str]] = []
    for key, locked in lock_packages.items():
        if key in installed:
            continue
        if isinstance(locked, dict):
            reason = optional_omission_reason(
                locked, node_platform, node_arch, frozenset(npm_reported_optional_paths), key
            )
            if reason is not None:
                optional_omissions.append({"path": key, "reason": reason})
                continue
        fail("npm tree", f"locked package is absent from installation: {key}")
    if set(declarations) != bin_dirs:
        fail("npm bins", f".bin level set drift: declarations={sorted(declarations)}, dirs={sorted(bin_dirs)}")
    bin_records: list[dict[str, Any]] = []
    for level in sorted(bin_dirs):
        directory = install_dir / level / ".bin"
        expected = declarations[level]
        actual_names = sorted(item.name for item in directory.iterdir())
        if actual_names != sorted(expected):
            fail("npm bins", f"bin name set drift at {level}")
        for entry in sorted(directory.iterdir(), key=lambda item: item.name):
            declaration = expected[entry.name]
            info = entry.lstat()
            target = declaration["target"]
            if stat.S_ISLNK(info.st_mode):
                raw_target = os.readlink(entry)
                if Path(raw_target).is_absolute():
                    fail("npm bins", f"absolute bin target: {entry}")
                if (entry.parent / raw_target).resolve(strict=True) != target.resolve(strict=True):
                    fail("npm bins", f"wrong bin target: {entry}")
                kind = "symlink"
            elif stat.S_ISREG(info.st_mode) and info.st_mode & stat.S_IXUSR:
                require_target_file(entry, root_real, root_real)
                if entry.read_bytes() != target.read_bytes():
                    fail("npm bins", f"copied bin bytes drift: {entry}")
                kind = "regular"
            else:
                fail("npm bins", f"unsafe bin entry: {entry}")
            bin_records.append({"path": entry.relative_to(install_dir).as_posix(), "kind": kind, "target": declaration["target_rel"], "target_sha256": sha256_file(target)})
    if "node_modules/.bin/vitest" not in {item["path"] for item in bin_records}:
        fail("npm bins", "vitest shim is missing")
    hidden = node_modules / ".package-lock.json"
    require_regular(hidden, "npm hidden lock")
    try:
        hidden_payload = json.loads(hidden.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail("npm hidden lock", f"hidden lock is malformed: {exc}")
    if hidden_payload.get("lockfileVersion") != 3 or not isinstance(hidden_payload.get("packages"), dict):
        fail("npm hidden lock", "hidden lock is not npm version 3")
    hidden_installed = {key for key in hidden_payload["packages"] if key}
    if hidden_installed != installed:
        fail("npm hidden lock", "hidden lock package subset differs from installed tree")
    expected_ls = {(item["name"], item["version"]) for item in records}
    if npm_identities != expected_ls:
        fail("npm ls", "npm ls dependency identities differ from installed tree")
    return {
        "schema": 1,
        "lockfile_version": 3,
        "packages": sorted(records, key=lambda item: item["path"]),
        "optional_omissions": sorted(optional_omissions, key=lambda item: item["path"]),
        "hidden_lock": {"path": hidden.relative_to(install_dir).as_posix(), "sha256": sha256_file(hidden)},
        "bins": sorted(bin_records, key=lambda item: item["path"]),
        "npm_ls_sha256": json_hash(npm_ls),
    }


def parse_vitest(path: Path, exit_code: int) -> dict[str, Any]:
    require_regular(path, "Vitest result")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail("Vitest result", f"machine result is malformed: {exc}")
    if not isinstance(value, dict):
        fail("Vitest result", "machine result is not an object")
    for key in VITEST_FIELDS:
        if key not in value or isinstance(value[key], bool) or not isinstance(value[key], int) or value[key] < 0:
            fail("Vitest result", f"missing or invalid count: {key}")
    if not isinstance(value.get("success"), bool) or not isinstance(value.get("testResults"), list):
        fail("Vitest result", "success or testResults is malformed")
    raw_suite_counts = {
        "numTotalTestSuites": value["numTotalTestSuites"],
        "numPassedTestSuites": value["numPassedTestSuites"],
        "numFailedTestSuites": value["numFailedTestSuites"],
        "numPendingTestSuites": value["numPendingTestSuites"],
    }
    if raw_suite_counts["numTotalTestSuites"] != (
        raw_suite_counts["numPassedTestSuites"]
        + raw_suite_counts["numFailedTestSuites"]
        + raw_suite_counts["numPendingTestSuites"]
    ):
        fail("Vitest result", "top-level suite count arithmetic drift")
    suites: list[dict[str, Any]] = []
    seen_names: set[str] = set()
    file_counts = {"passed": 0, "failed": 0, "pending": 0}
    assertion_counts = {"passed": 0, "failed": 0, "pending": 0, "todo": 0}
    diagnostics: list[dict[str, str]] = []
    for raw_suite in value["testResults"]:
        if not isinstance(raw_suite, dict) or not isinstance(raw_suite.get("name"), str) or not raw_suite["name"] or raw_suite["name"] in seen_names:
            fail("Vitest result", "suite names must be nonempty and unique")
        name = raw_suite["name"]
        seen_names.add(name)
        status = raw_suite.get("status")
        assertions = raw_suite.get("assertionResults")
        message = "" if raw_suite.get("message") is None else " ".join(str(raw_suite.get("message")).split())
        if status not in {"passed", "failed", "pending"} or not isinstance(assertions, list):
            fail("Vitest result", f"invalid suite: {name}")
        if status in {"passed", "pending"} and not assertions:
            fail("Vitest result", f"empty assertion list for {status} suite: {name}")
        if status == "failed" and not assertions:
            if not message:
                fail("Vitest result", f"failed suite has no diagnostic: {name}")
            diagnostics.append({"suite": name, "message": message, "signature": sha256_bytes(message.encode()), "kind": "suite-level import/setup/transform application failure"})
        file_counts[status] += 1
        detail_assertions: list[dict[str, Any]] = []
        for assertion in assertions:
            if not isinstance(assertion, dict) or assertion.get("status") not in assertion_counts:
                fail("Vitest result", f"invalid assertion in suite: {name}")
            assertion_counts[assertion["status"]] += 1
            detail_assertions.append({"ancestorTitles": assertion.get("ancestorTitles", []), "fullName": assertion.get("fullName", ""), "status": assertion["status"], "title": assertion.get("title", "")})
        suites.append({"name": name, "status": status, "message": message, "assertions": detail_assertions})
    test_counts = {
        "numTotalTests": sum(assertion_counts.values()),
        "numPassedTests": assertion_counts["passed"],
        "numFailedTests": assertion_counts["failed"],
        "numPendingTests": assertion_counts["pending"],
        "numTodoTests": assertion_counts["todo"],
    }
    for key, expected in test_counts.items():
        if value[key] != expected:
            fail("Vitest result", f"top-level count drift: {key}")
    top_failed = raw_suite_counts["numFailedTestSuites"] > 0
    file_failed = file_counts["failed"] > 0
    if top_failed != file_failed:
        fail("Vitest result", "failed file records do not agree with top-level suite failures")
    expected_success = not top_failed and assertion_counts["failed"] == 0 and not file_failed
    if value["success"] != expected_success or value["success"] != (exit_code == 0):
        fail("Vitest result", "success does not agree with details/process exit")
    actual = {**raw_suite_counts, **test_counts}
    return {"schema": 1, "counts": actual, "success": value["success"], "exit_code": exit_code, "suites": suites, "suite_diagnostics": diagnostics}


class FrontendRun:
    def __init__(self, repo: Path):
        self.repo = repo
        self.frontend = repo / "frontend"
        self.tree = load_tree_helper(repo)
        self.source_before: dict[str, Any] | None = None
        self.source_after: dict[str, Any] | None = None
        self.package_hash = ""
        self.lock_hash = ""
        self.input_key = ""
        self.input_namespace: Path | None = None
        self.install_dir: Path | None = None
        self.runtime_dir: Path | None = None
        self.result_dir: Path | None = None
        self.run_id = ""
        self.global_fd: int | None = None
        self.keyed_fd: int | None = None
        self.original_link: tuple[str, str | None] | None = None
        self.linked = False
        self.env: dict[str, str] = {}
        self.node: Path | None = None
        self.npm: Path | None = None
        self.node_platform = ""
        self.node_arch = ""
        self.commands: dict[str, Any] = {}
        self.tree_payload: dict[str, Any] | None = None
        self.vitest_payload: dict[str, Any] | None = None
        self.config_values: dict[str, Any] | None = None
        self.config_sources: dict[str, Any] | None = None
        self.config_files: dict[str, Path] = {}
        self.empty_config_hashes: dict[str, str] = {}
        self.failure: dict[str, str] | None = None
        self.application_failure = False
        self._registered_result_names: set[str] = set()
        self.started = time.time()

    def fail(self, label: str, message: str) -> None:
        self.failure = {"label": label, "message": message}
        raise FrontendError(label, message)

    def register_result_name(self, name: str) -> None:
        """Admit one fixed direct-child artifact name before its command/write."""
        fixed = {
            "npm-config-values.json", "npm-config-sources.json", "npm-ls.json", "npm-tree.json",
            "vitest.json", "pre-source-manifest.json", "post-source-manifest.json",
        }
        command_output = re.fullmatch(r"[A-Za-z0-9_-]+\.(?:stdout|stderr)\.(?:txt|json|log)", name or "")
        if name not in fixed and command_output is None:
            self.fail("frontend evidence", f"result artifact name is not command-owned: {name!r}")
        if name in self._registered_result_names:
            self.fail("frontend evidence", f"result artifact name registered twice: {name}")
        self._registered_result_names.add(name)

    def load_result_artifacts(self) -> dict[str, ArtifactBytes]:
        """Require exactly registered direct children and load each once no-follow."""
        if self.result_dir is None:
            self.fail("frontend evidence", "result directory is unavailable")
        return read_direct_children_nofollow(self.result_dir, set(self._registered_result_names))

    def record_command(
        self,
        name: str,
        argv: list[str],
        cwd: Path,
        stdout_name: str,
        stderr_name: str,
    ) -> tuple[dict[str, Any], bytes, bytes]:
        assert self.result_dir and self.install_dir
        self.register_result_name(stdout_name)
        self.register_result_name(stderr_name)
        return command_record(
            name, argv, cwd, self.env, self.result_dir, self.repo, self.install_dir, stdout_name, stderr_name
        )

    def prepare(self) -> None:
        require_directory(self.frontend, "frontend source")
        npmrc = self.frontend / ".npmrc"
        if lstat_or_none(npmrc) is not None:
            self.fail("source npmrc", "frontend/.npmrc must be absent")
        self.original_link = source_node_modules_state(self.frontend)
        self.source_before = source_snapshot(self.repo, self.tree)
        self.package_hash, self.lock_hash, self.input_key = input_hashes(self.frontend)
        self.input_namespace = self.repo / "test-results" / "frontend-installations" / self.input_key
        canonical_repo = str(self.repo.resolve())
        global_name = sha256_bytes(canonical_repo.encode())
        self.global_fd = safe_lock(Path("/tmp") / f"scai-frontend-{global_name}.lock", "frontend global lock")
        ensure_directory(self.repo / "test-results", "frontend evidence root")
        ensure_directory(self.repo / "test-results" / "frontend-installations", "frontend input namespace root")
        ensure_directory(self.input_namespace, "frontend input namespace")
        ensure_directory(self.input_namespace / "runs", "frontend input runs")
        self.keyed_fd = safe_lock(self.input_namespace / ".install.lock", "frontend keyed lock")
        latest_source = source_snapshot(self.repo, self.tree)
        latest_hashes = input_hashes(self.frontend)
        latest_link = source_node_modules_state(self.frontend)
        if lstat_or_none(self.frontend / ".npmrc") is not None:
            self.fail("source npmrc", "frontend/.npmrc appeared while locks were acquired")
        if latest_source != self.source_before or latest_hashes != (self.package_hash, self.lock_hash, self.input_key) or latest_link != self.original_link:
            self.fail("frontend source identity", "source or frontend inputs changed while locks were acquired")
        self.run_id = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex[:12]
        self.install_dir = self.input_namespace / "runs" / self.run_id
        try:
            self.install_dir.mkdir(mode=0o700)
        except FileExistsError:
            self.fail("frontend install", "run directory already exists")
        self.result_dir = self.repo / "test-results" / f"{self.run_id}-frontend"
        try:
            self.result_dir.mkdir(mode=0o700)
        except FileExistsError:
            self.fail("frontend evidence", "result directory already exists")
        for source_name in ("package.json", "package-lock.json"):
            source = self.frontend / source_name
            destination = self.install_dir / source_name
            shutil.copyfile(source, destination)
            require_regular(destination, "frontend copied input")
        if sha256_file(self.install_dir / "package.json") != self.package_hash or sha256_file(self.install_dir / "package-lock.json") != self.lock_hash:
            self.fail("frontend inputs", "copied input hash differs from source")
        self.runtime_dir = self.install_dir / ".scai-runtime"
        ensure_directory(self.runtime_dir, "frontend runtime directory")
        self.node = Path(shutil.which("node") or "")
        self.npm = Path(shutil.which("npm") or "")
        if not self.node or not self.node.is_file() or not self.npm or not self.npm.is_file():
            self.fail("frontend tools", "node and npm are not resolvable")
        self.env = command_env(self.node, self.npm, self.install_dir, self.runtime_dir)
        self.config_files = {
            "userconfig": self.install_dir / ".npmrc",
            "globalconfig": self.install_dir / "global.npmrc",
        }
        empty_hashes = {
            "userconfig": empty_config_file(self.install_dir / ".npmrc"),
            "globalconfig": empty_config_file(self.install_dir / "global.npmrc"),
        }
        self.empty_config_hashes = empty_hashes
        self.commands["empty_config_hashes"] = empty_hashes
        platform_record, platform_raw, platform_err = self.record_command(
            "node_platform",
            [str(self.node), "-p", NODE_PLATFORM_QUERY],
            self.install_dir,
            "node-platform.stdout.json",
            "node-platform.stderr.log",
        )
        if platform_record["exit_code"] != 0 or platform_err:
            self.fail("frontend tools", "node platform query failed")
        try:
            parsed_platform = json.loads(platform_raw.decode("utf-8"))
        except (UnicodeDecodeError, ValueError) as exc:
            self.fail("frontend tools", f"node platform query is malformed: {exc}")
        if (
            not isinstance(parsed_platform, dict)
            or set(parsed_platform) != {"platform", "arch"}
            or not isinstance(parsed_platform["platform"], str)
            or not parsed_platform["platform"]
            or not isinstance(parsed_platform["arch"], str)
            or not parsed_platform["arch"]
        ):
            self.fail("frontend tools", "node platform query returned an invalid identity")
        self.node_platform = parsed_platform["platform"]
        self.node_arch = parsed_platform["arch"]
        self.commands["node_platform"] = {**platform_record, "parsed": parsed_platform}
        version_commands = {}
        for name, executable in (("node_version", self.node), ("npm_version", self.npm)):
            if name == "npm_version":
                verify_config_files(self.config_files, self.empty_config_hashes)
            record, stdout, stderr = self.record_command(
                name, [str(executable), "--version"], self.install_dir,
                f"{name}.stdout.txt", f"{name}.stderr.log",
            )
            if record["exit_code"] != 0 or stderr:
                self.fail("frontend tools", f"{name} command failed")
            version_commands[name] = {**record, "version": stdout.decode("utf-8", "replace").strip()}
        self.commands["versions"] = version_commands
        expected = expected_config(self.install_dir, self.result_dir / "cache", self.install_dir / ".npmrc", self.install_dir / "global.npmrc")
        # The npm cache is created by command_env under the isolated install runtime;
        # use the exact environment path as the planned effective value.
        expected["cache"] = str(Path(self.env["npm_config_cache"]).resolve())
        verify_config_files(self.config_files, self.empty_config_hashes)
        values_record, values_raw, values_err = self.record_command(
            "npm_config_values", [str(self.npm), "config", "list", "--json"], self.install_dir,
            "npm-config-values.stdout.json", "npm-config-values.stderr.log",
        )
        self.commands["npm_config_values"] = values_record
        if values_record["exit_code"] != 0 or values_err:
            self.fail("npm config values", "npm config list --json failed or wrote stderr")
        self.config_values = parse_npm_config_values(values_raw, expected, empty_hashes)
        verify_config_files(self.config_files, self.empty_config_hashes)
        sources_record, sources_raw, sources_err = self.record_command(
            "npm_config_sources", [str(self.npm), "config", "list"], self.install_dir,
            "npm-config-sources.stdout.txt", "npm-config-sources.stderr.log",
        )
        self.commands["npm_config_sources"] = sources_record
        if sources_record["exit_code"] != 0 or sources_err:
            self.fail("npm config sources", "npm config list failed or wrote stderr")
        self.config_sources = parse_npm_config_sources(sources_raw, expected, empty_hashes, self.install_dir)
        validate_npm_config_agreement(self.config_values, self.config_sources)
        verify_config_files(self.config_files, self.empty_config_hashes)
        self.register_result_name("npm-config-values.json")
        self.register_result_name("npm-config-sources.json")
        write_json(self.result_dir / "npm-config-values.json", self.config_values)
        write_json(self.result_dir / "npm-config-sources.json", self.config_sources)

    def run_install(self) -> None:
        assert self.install_dir and self.result_dir and self.npm
        verify_config_files(self.config_files, self.empty_config_hashes)
        record, _stdout, _stderr = self.record_command(
            "npm_ci", [str(self.npm), "ci"], self.install_dir, "npm-ci.stdout.txt", "npm-ci.stderr.log"
        )
        self.commands["npm_ci"] = record
        if record["exit_code"] != 0:
            self.fail("npm ci", f"npm ci exited {record['exit_code']}")
        verify_config_files(self.config_files, self.empty_config_hashes)
        record, stdout, stderr = self.record_command(
            "npm_ls", [str(self.npm), "ls", "--all", "--json"], self.install_dir,
            "npm-ls.stdout.json", "npm-ls.stderr.log",
        )
        self.commands["npm_ls"] = record
        if record["exit_code"] != 0:
            self.fail("npm ls", f"npm ls exited {record['exit_code']}")
        try:
            npm_ls = json.loads(stdout.decode("utf-8"))
        except (UnicodeDecodeError, ValueError) as exc:
            self.fail("npm ls", f"npm ls JSON is malformed: {exc}")
        if not isinstance(npm_ls, dict) or npm_ls.get("problems"):
            self.fail("npm ls", "npm ls reports problems")
        npm_inventory = npm_ls_inventory(npm_ls)
        if not isinstance(self.node_platform, str) or not self.node_platform or not isinstance(self.node_arch, str) or not self.node_arch:
            self.fail("npm tree", "node platform identity is unavailable")
        self.register_result_name("npm-ls.json")
        write_json(self.result_dir / "npm-ls.json", npm_ls)
        self.tree_payload = walk_npm_tree(self.install_dir, npm_ls, self.node_platform, self.node_arch, npm_inventory)
        self.register_result_name("npm-tree.json")
        write_json(self.result_dir / "npm-tree.json", self.tree_payload)

    def verify_vitest_shim(self) -> None:
        assert self.install_dir and self.tree_payload
        expected = next((item for item in self.tree_payload["bins"] if item["path"] == "node_modules/.bin/vitest"), None)
        if expected is None:
            self.fail("npm bins", "verified vitest shim is missing")
        link = self.install_dir / "node_modules/.bin/vitest"
        if not link.is_symlink() or link.resolve(strict=True).relative_to(self.install_dir.resolve()).as_posix() != expected["target"]:
            self.fail("npm bins", "vitest shim changed after tree validation")

    def link_and_test(self) -> None:
        assert self.install_dir and self.result_dir and self.npm
        helper = self.repo / "scripts" / "link_frontend_node_modules.sh"
        require_regular(helper, "frontend link helper")
        vitest_path = self.result_dir / "vitest.json"
        try:
            self.linked = True
            self.register_result_name("link.stdout.txt")
            self.register_result_name("link.stderr.log")
            with (self.result_dir / "link.stdout.txt").open("wb") as stdout, (self.result_dir / "link.stderr.log").open("wb") as stderr:
                subprocess.run(["bash", str(helper), str(self.frontend), str(self.install_dir / "node_modules")], cwd=self.repo, env=self.env, stdout=stdout, stderr=stderr, check=True)
            self.verify_vitest_shim()
            verify_config_files(self.config_files, self.empty_config_hashes)
            self.register_result_name("vitest.json")
            record, _stdout, _stderr = self.record_command(
                "npm_test", [str(self.npm), "test", "--", "--reporter=json", f"--outputFile={vitest_path}"],
                self.frontend, "npm-test.stdout.txt", "npm-test.stderr.log",
            )
            self.commands["npm_test"] = record
            self.vitest_payload = parse_vitest(vitest_path, record["exit_code"])
            if record["exit_code"] != 0:
                self.application_failure = True
        except subprocess.CalledProcessError as exc:
            self.fail("frontend link", f"link helper exited {exc.returncode}")

    def restore_link(self) -> None:
        if not self.linked:
            return
        path = self.frontend / "node_modules"
        original_kind, original_target = self.original_link or ("absent", None)
        info = lstat_or_none(path)
        if info is not None and not stat.S_ISLNK(info.st_mode):
            self.fail("frontend restoration", "helper left a non-symlink node_modules path")
        if original_kind == "absent":
            if info is not None:
                path.unlink()
        elif original_kind == "symlink" and original_target is not None:
            temporary = self.frontend / f".node_modules.restore.{uuid.uuid4().hex}"
            os.symlink(original_target, temporary)
            os.replace(temporary, path)
        else:
            self.fail("frontend restoration", "original node_modules state is invalid")
        final_kind, final_target = source_node_modules_state(self.frontend)
        if (final_kind, final_target) != (original_kind, original_target):
            self.fail("frontend restoration", "frontend/node_modules was not restored exactly")
        self.linked = False

    def check_source_after(self) -> None:
        if lstat_or_none(self.frontend / ".npmrc") is not None:
            self.fail("source npmrc", "frontend/.npmrc was created during frontend run")
        if self.original_link is not None and source_node_modules_state(self.frontend) != self.original_link:
            self.fail("frontend source identity", "frontend/node_modules state changed during frontend run")
        self.source_after = source_snapshot(self.repo, self.tree)
        if self.source_before != self.source_after:
            self.fail("frontend source identity", "source manifest changed during frontend run")

    def artifact_manifest(self, artifacts: dict[str, ArtifactBytes]) -> dict[str, Any]:
        """Build the detached index from the one trusted artifact byte snapshot."""
        entries = [
            {"path": item.name, "size": item.size, "sha256": item.sha256}
            for item in (artifacts[name] for name in sorted(artifacts))
        ]
        return {"schema": 1, "entries": entries, "digest": json_hash(entries)}

    def evidence(self, status: str, manifest: dict[str, Any]) -> dict[str, Any]:
        assert self.result_dir
        source = {"base_commit": BASE_COMMIT, "manifest": self.source_before, "manifest_after": self.source_after}
        installation = tokenized({"namespace": str(self.input_namespace) if self.input_namespace else None, "run_dir": str(self.install_dir) if self.install_dir else None}, self.repo, self.result_dir, self.install_dir)
        if self.run_id and installation.get("run_dir") == "<install-dir>":
            installation["run_dir"] = f"<install-dir>/{self.run_id}"
        return {
            "schema": 1,
            "run_id": self.run_id,
            "status": status,
            "source": tokenized(source, self.repo, self.result_dir, self.install_dir),
            "node_version": self.commands.get("versions", {}).get("node_version", {}).get("version"),
            "npm_version": self.commands.get("versions", {}).get("npm_version", {}).get("version"),
            "package_json_sha256": self.package_hash,
            "package_lock_sha256": self.lock_hash,
            "input_key": self.input_key,
            "installation": installation,
            "effective_environment": tokenized(self.env, self.repo, self.result_dir, self.install_dir),
            "npm_config_values": tokenized(self.config_values, self.repo, self.result_dir, self.install_dir),
            "npm_config_sources": tokenized(self.config_sources, self.repo, self.result_dir, self.install_dir),
            "commands": tokenized(self.commands, self.repo, self.result_dir, self.install_dir),
            "tree": tokenized(self.tree_payload, self.repo, self.result_dir, self.install_dir),
            "vitest": tokenized(self.vitest_payload, self.repo, self.result_dir, self.install_dir),
            "error": tokenized(self.failure, self.repo, self.result_dir, self.install_dir),
            "artifacts": manifest,
            "utc_start_epoch": self.started,
            "utc_end_epoch": time.time(),
            "duration_seconds": round(max(0.0, time.time() - self.started), 6),
        }

    def finish(self, status: str) -> None:
        if self.result_dir is None:
            return
        if self.source_before is not None:
            self.register_result_name("pre-source-manifest.json")
            write_json(self.result_dir / "pre-source-manifest.json", self.source_before)
        if self.source_after is not None:
            self.register_result_name("post-source-manifest.json")
            write_json(self.result_dir / "post-source-manifest.json", self.source_after)
        fsync_directory(self.result_dir)
        artifacts = self.load_result_artifacts()
        manifest = self.artifact_manifest(artifacts)
        manifest_payload = json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8") + b"\n"
        evidence = self.evidence(status, manifest)
        evidence_payload = json.dumps(evidence, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8") + b"\n"
        write_sealed_file(self.result_dir, "artifact-manifest.json", manifest_payload)
        write_sealed_file(self.result_dir, "evidence.json", evidence_payload)

    def close(self) -> FrontendError | None:
        """Restore the source link and prove final source identity while locked."""
        try:
            self.restore_link()
            if self.source_before is not None:
                self.check_source_after()
        except FrontendError as exc:
            self.failure = {"label": exc.label, "message": str(exc)}
            return exc
        return None

    def release_locks(self) -> None:
        """Release keyed then global locks; safe to call once in the outer finally."""
        keyed_fd, global_fd = self.keyed_fd, self.global_fd
        self.keyed_fd = None
        self.global_fd = None
        try:
            unlock(keyed_fd)
        finally:
            unlock(global_fd)


def main(argv: list[str]) -> int:
    if argv != ["--install-and-test"]:
        print("Usage: scripts/scai-frontend-test --install-and-test", file=sys.stderr)
        return 2
    repo = Path(os.environ.get("SCAI_FRONTEND_RUNNER_PATH", __file__)).resolve().parents[1]
    run = FrontendRun(repo)

    def interrupted(signum: int, _frame: Any) -> None:
        run.failure = {"label": "frontend signal", "message": f"received signal {signum}; restoring source link"}
        raise KeyboardInterrupt

    for signal_number in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, interrupted)
    status = "failed"
    try:
        run.prepare()
        run.run_install()
        run.link_and_test()
        status = "application_failure" if run.application_failure else "passed"
    except FrontendError as exc:
        run.failure = {"label": exc.label, "message": str(exc)}
    except KeyboardInterrupt:
        pass
    except Exception as exc:
        run.failure = {"label": "frontend runner", "message": f"{type(exc).__name__}: {exc}"}
    finally:
        close_error: FrontendError | None = None
        try:
            close_error = run.close()
        except Exception as exc:
            close_error = FrontendError("frontend close", f"{type(exc).__name__}: {exc}")
            run.failure = {"label": close_error.label, "message": str(close_error)}
    if close_error is not None:
        status = "failed"
    try:
        run.finish(status)
    except Exception as exc:
        status = "failed"
        run.failure = {"label": "frontend evidence", "message": f"{type(exc).__name__}: {exc}"}
        print(f"error: frontend evidence: {exc}", file=sys.stderr)
    finally:
        run.release_locks()
    if status == "passed":
        return 0
    print(f"error: frontend {status}: {run.failure or 'unknown failure'}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
