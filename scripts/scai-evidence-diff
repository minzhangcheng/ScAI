#!/usr/bin/env python3
"""Compare two scripts/scai-test runs by failing node-id set.

The failure *count* is not acceptance: two different sets of the same size
satisfy it. Nor is the failing set alone: deleting every passing and skipped
record from a junit.xml leaves that set intact, so the file is authenticated
against the size and SHA-256 the runner published for it, and its case count is
checked against the run's own ``collected``. A run whose collection did not
complete, whose junit.xml is unauthenticated or altered, or whose junit
disagrees with its own recorded counts, measured nothing. All of those exit 2,
never 0 -- silence is not agreement.
"""
from __future__ import annotations

import hashlib
import json
import pathlib
import sys
import xml.etree.ElementTree as ET


def load(run: pathlib.Path) -> tuple[str, set[str]]:
    """Return (profile, failing node ids) for one run, or raise LookupError.

    Validating here rather than in a checklist step is deliberate: a check the
    operator has to remember is a check that gets skipped on the twelfth batch.

    Note: pytest can emit a junit ``<error>`` for a teardown fault on a test
    that also passed, which the failed+errors cross-check reports as a
    disagreement. That surfaces as exit 2 -- look at it -- never as agreement.

    The digest check and the case-count check are deliberately both here. The
    digest alone is defeated by re-recording it after altering the file; the
    count alone is defeated by any edit that preserves the number of cases.
    """
    junit = run / "junit.xml"
    evidence = run / "evidence.json"
    if not junit.is_file():
        raise LookupError("no junit.xml under %s" % run)
    if not evidence.is_file():
        raise LookupError("no evidence.json under %s" % run)

    data = json.loads(evidence.read_text())
    if (data.get("outcomes") or {}).get("complete") is not True:
        raise LookupError("%s: collection did not complete" % run)

    entry = (data.get("artifacts") or {}).get("junit.xml")
    if not entry:
        raise LookupError("%s: evidence.json does not record a junit.xml artifact" % run)
    raw = junit.read_bytes()
    if int(entry.get("size", -1)) != len(raw):
        raise LookupError(
            "%s: junit.xml is %d bytes, evidence records %s"
            % (run, len(raw), entry.get("size"))
        )
    if entry.get("sha256") != hashlib.sha256(raw).hexdigest():
        raise LookupError("%s: junit.xml does not match its recorded sha256" % run)

    counts = data.get("counts") or {}
    root = ET.fromstring(raw)
    cases = list(root.iter("testcase"))
    if not cases:
        raise LookupError("no test cases parsed from %s" % junit)
    collected = int(counts.get("collected", -1))
    if len(cases) != collected:
        raise LookupError(
            "%s: junit.xml holds %d test cases, evidence collected %d"
            % (run, len(cases), collected)
        )

    names = set()
    for case in cases:
        for child in case:
            if child.tag in ("failure", "error"):
                names.add("%s::%s" % (case.get("classname"), case.get("name")))

    declared = int(counts.get("failed", -1)) + int(counts.get("errors", 0))
    if declared != len(names):
        raise LookupError(
            "%s: evidence declares %d failed+errors, junit.xml carries %d"
            % (run, declared, len(names))
        )
    return str(data.get("profile") or ""), names


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print("usage: scai-evidence-diff <base-run-dir> <new-run-dir>",
              file=sys.stderr)
        return 2
    try:
        base_profile, base = load(pathlib.Path(argv[1]))
        new_profile, new = load(pathlib.Path(argv[2]))
    except (LookupError, ValueError, json.JSONDecodeError, ET.ParseError) as exc:
        print("INCONCLUSIVE: %s" % exc, file=sys.stderr)
        return 2

    if base_profile != new_profile:
        print("INCONCLUSIVE: different profiles: %r vs %r"
              % (base_profile, new_profile), file=sys.stderr)
        return 2

    introduced = sorted(new - base)
    fixed = sorted(base - new)
    print("profile: %s" % base_profile)
    print("base failing: %d    new failing: %d" % (len(base), len(new)))
    print("introduced: %s" % ("none" if not introduced else ""))
    for node in introduced:
        print("    + %s" % node)
    print("fixed: %s" % ("none" if not fixed else ""))
    for node in fixed:
        print("    - %s" % node)
    return 0 if not introduced and not fixed else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
